# Flagsmith Cloud server-side environment keys (Environment -> SDK Keys -> Server-side).
# One per environment, because each run has its own environment and experiment.
# The simulator picks one with --env, e.g. `npm run sim -- --env baseline` uses FLAGSMITH_KEY_BASELINE.
FLAGSMITH_KEY_SMOKE=
FLAGSMITH_KEY_BASELINE=
FLAGSMITH_KEY_AA=
FLAGSMITH_KEY_PERSONASWAP=

# The player (apps/player) uses the Live environment's client-side key, set in Vercel:
# NEXT_PUBLIC_FLAGSMITH_KEY=

# Fallback used when --env is not given (and by scripts/smoke.ts).
FLAGSMITH_ENVIRONMENT_KEY=
